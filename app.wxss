/* 全局样式 */
page {
  background: #f4f6f5;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #22302b;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(34, 48, 43, 0.05);
}

.muted {
  color: #8d9a95;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  background: #eaf6f0;
  color: #2d7d5a;
}

.btn-primary {
  background: linear-gradient(135deg, #37a06f, #2d7d5a);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(45, 125, 90, 0.22);
}

.btn-primary.disabled {
  background: #cfd8d4;
  box-shadow: none;
  color: #f2f4f3;
}

.btn-ghost {
  background: #fff;
  color: #2d7d5a;
  border: 2rpx solid #bcdccc;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  text-align: center;
}

.empty {
  padding: 140rpx 40rpx;
  text-align: center;
  color: #9aa5a0;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1;
  opacity: 0.35;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #22302b;
  margin: 34rpx 0 18rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #2d7d5a;
  line-height: 1.2;
}
