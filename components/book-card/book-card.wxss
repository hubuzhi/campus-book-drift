.book-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.cover {
  width: 150rpx;
  height: 200rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.cover-title {
  color: #fff;
  font-size: 24rpx;
  line-height: 1.3;
  text-align: center;
  font-weight: 600;
}

.info {
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.author {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 8rpx;
}

.meta {
  margin-top: 12rpx;
}

.status {
  font-size: 24rpx;
}

.status.ok {
  color: #2d7d5a;
}

.status.out {
  color: #c0392b;
}
