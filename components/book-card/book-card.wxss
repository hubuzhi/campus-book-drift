.book-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(34, 48, 43, 0.05);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.card-hover {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx rgba(34, 48, 43, 0.08);
}

.cover {
  position: relative;
  width: 150rpx;
  height: 204rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 16rpx 14rpx 26rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  overflow: hidden;
}

/* 书脊 */
.spine {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 12rpx;
  background: rgba(0, 0, 0, 0.18);
}

/* 高光 */
.cover-sheen {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.cover-title {
  color: #fff;
  font-size: 24rpx;
  line-height: 1.35;
  text-align: center;
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.18);
}

.info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.title {
  font-size: 31rpx;
  font-weight: 600;
  color: #22302b;
  line-height: 1.35;
}

.author {
  font-size: 24rpx;
  color: #8d9a95;
  margin-top: 8rpx;
}

.meta {
  margin-top: 14rpx;
}

.status {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot.ok { background: #35a06b; }
.dot.out { background: #d0553f; }

.ok-text {
  color: #35a06b;
  font-size: 24rpx;
}

.out-text {
  color: #d0553f;
  font-size: 24rpx;
}
