.hero {
  height: 380rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.hero-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  padding: 0 40rpx;
}

.hero-author {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 16rpx;
}

.desc-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 28rpx 0 12rpx;
}

.desc {
  font-size: 28rpx;
  line-height: 1.7;
  color: #555;
}

.info-row {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.flex1 {
  flex: 1;
}

.ok {
  color: #2d7d5a;
}

.out {
  color: #c0392b;
}
