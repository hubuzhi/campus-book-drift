.hero {
  position: relative;
  height: 400rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(34, 48, 43, 0.18);
}

.hero-spine {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 20rpx;
  background: rgba(0, 0, 0, 0.2);
}

.hero-sheen {
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.hero-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

.hero-title {
  color: #fff;
  font-size: 46rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.35;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.hero-author {
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  margin-top: 18rpx;
}

.head {
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f2f5f4;
}

.status {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot.ok { background: #35a06b; }
.dot.out { background: #d0553f; }

.ok-text { color: #35a06b; font-size: 24rpx; }
.out-text { color: #d0553f; font-size: 24rpx; }

.desc-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 28rpx 0 14rpx;
}

.desc {
  font-size: 28rpx;
  line-height: 1.75;
  color: #55635e;
}

.info-row {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid #f2f5f4;
}

.owner {
  display: flex;
  align-items: center;
}

.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eaf6f0;
  color: #2d7d5a;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  overflow: hidden;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.flex1 {
  flex: 1;
}

.related {
  display: flex;
  gap: 20rpx;
}

.rel-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 48, 43, 0.05);
}

.rel-cover {
  height: 160rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
  margin-bottom: 14rpx;
}

.rel-title {
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 1.3;
  font-weight: 600;
}

.rel-name {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  margin-bottom: 4rpx;
}
