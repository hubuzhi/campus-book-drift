<view class="container">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索书名或作者" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <scroll-view class="cats" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="cat {{category === item ? 'active' : ''}}"
      data-cat="{{item}}"
      bindtap="onCategory">{{item}}</view>
  </scroll-view>

  <view wx:if="{{list.length === 0}}" class="empty">还没有符合条件的书</view>

  <book-card
    wx:for="{{list}}"
    wx:key="id"
    book="{{item}}"
    bind:booktap="onBookTap" />

  <view wx:if="{{hasMore}}" class="load-more muted">上拉加载更多</view>
  <view wx:if="{{!hasMore && list.length > 0}}" class="load-more muted">— 已经到底啦 —</view>
</view>
