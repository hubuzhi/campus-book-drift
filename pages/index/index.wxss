.search-bar {
  position: relative;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 100rpx;
  padding: 0 28rpx;
  height: 84rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 48, 43, 0.05);
  margin-bottom: 22rpx;
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.45;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
}

.ph {
  color: #b3bcb8;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef1f0;
  color: #8d9a95;
  font-size: 22rpx;
}

.cats {
  white-space: nowrap;
  margin-bottom: 26rpx;
}

.cat {
  display: inline-block;
  padding: 12rpx 30rpx;
  background: #fff;
  border-radius: 100rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #6b7873;
  border: 2rpx solid transparent;
}

.cat.active {
  background: #eaf6f0;
  color: #2d7d5a;
  border-color: #bfe0cf;
  font-weight: 600;
}

.load-more {
  text-align: center;
  padding: 34rpx 0 50rpx;
}
