.profile-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #37a06f, #2d7d5a);
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 12rpx 30rpx rgba(45, 125, 90, 0.25);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 42rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.btn-login {
  padding: 14rpx 34rpx;
  background: #fff;
  color: #2d7d5a;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.btn-logout {
  padding: 14rpx 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  color: #fff;
  border-radius: 100rpx;
  font-size: 26rpx;
}

.stats {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 34rpx 0;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(34, 48, 43, 0.05);
}

.stat {
  flex: 1;
  text-align: center;
}

.num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d7d5a;
  line-height: 1.2;
}

.stat-label {
  font-size: 23rpx;
  color: #8d9a95;
  margin-top: 6rpx;
}

.divider {
  width: 2rpx;
  height: 48rpx;
  background: #eef1f0;
}

.about {
  margin-top: 24rpx;
}

.about-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.about-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f5f7f6;
  font-size: 26rpx;
}

.about-row:last-child {
  border-bottom: none;
}

.about-k {
  color: #8d9a95;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.about-v {
  color: #55635e;
  text-align: right;
}
