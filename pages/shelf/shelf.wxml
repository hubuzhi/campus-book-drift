<view class="container">
  <view class="tabs">
    <view class="tab {{tab === 'collect' ? 'active' : ''}}" data-tab="collect" bindtap="switchTab">
      我的收藏 ({{collected.length}})
    </view>
    <view class="tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">
      我发布的 ({{mine.length}})
    </view>
  </view>

  <block wx:if="{{tab === 'collect'}}">
    <view wx:if="{{collected.length === 0}}" class="empty">还没有收藏的书
去书库逛逛吧</view>
    <view wx:for="{{collected}}" wx:key="id" class="card item" data-id="{{item.id}}" bindtap="onBookTap">
      <view class="dot" style="background: {{item.color}}"></view>
      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view class="muted">{{item.author}}</view>
      </view>
      <text class="tag">{{item.status === 'available' ? '可借' : '已借出'}}</text>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{mine.length === 0}}" class="empty">还没有发布过图书</view>
    <view wx:for="{{mine}}" wx:key="id" class="card item" data-id="{{item.id}}" bindtap="onBookTap">
      <view class="dot" style="background: {{item.color}}"></view>
      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view class="muted">{{item.author}}</view>
      </view>
      <text class="tag">{{item.status === 'available' ? '可借' : '已借出'}}</text>
    </view>
  </block>
</view>
