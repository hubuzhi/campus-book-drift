.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}

.tab.active {
  background: #eaf5ef;
  color: #2d7d5a;
  font-weight: 600;
}

.item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dot {
  width: 80rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
}
