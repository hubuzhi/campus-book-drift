.tabs {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 48, 43, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #6b7873;
  border-radius: 14rpx;
}

.tab.active {
  background: #eaf6f0;
  color: #2d7d5a;
  font-weight: 600;
}

.count {
  display: inline-block;
  min-width: 34rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #2d7d5a;
  background: rgba(45, 125, 90, 0.12);
  border-radius: 100rpx;
}

.item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(34, 48, 43, 0.05);
  transition: transform 0.12s ease;
}

.item-hover {
  transform: scale(0.985);
}

.cover {
  position: relative;
  width: 110rpx;
  height: 150rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 12rpx 10rpx 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
}

.spine {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 9rpx;
  background: rgba(0, 0, 0, 0.18);
}

.cover-title {
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 1.3;
  font-weight: 600;
}

.item-info {
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.ok { color: #35a06b; font-size: 24rpx; }
.out { color: #d0553f; font-size: 24rpx; }
