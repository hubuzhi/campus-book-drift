.field {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.input {
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 28rpx;
  background: #f2f3f5;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #666;
}

.chip.active {
  background: #2d7d5a;
  color: #fff;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.color-dot.selected {
  border-color: #2c2c2c;
}

.submit {
  margin-top: 40rpx;
}
