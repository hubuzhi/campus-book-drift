<view class="container">
  <view class="card">
    <view class="field">
      <view class="label">书名 <text class="req">*</text></view>
      <input class="input" placeholder="例如：深入理解计算机系统" placeholder-class="ph"
             data-field="title" value="{{title}}" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">作者 <text class="req">*</text></view>
      <input class="input" placeholder="例如：Randal E. Bryant" placeholder-class="ph"
             data-field="author" value="{{author}}" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">分类</view>
      <view class="chips">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="chip {{category === item ? 'active' : ''}}"
          data-cat="{{item}}"
          bindtap="onPickCategory">{{item}}</view>
      </view>
    </view>

    <view class="field">
      <view class="label">封面配色</view>
      <view class="chips">
        <view
          wx:for="{{colors}}"
          wx:key="*this"
          class="color-dot {{color === item ? 'selected' : ''}}"
          style="background: {{item}}"
          data-color="{{item}}"
          bindtap="onPickColor"></view>
      </view>
    </view>

    <view class="field">
      <view class="label row between">
        <text>简介</text>
        <text class="counter">{{descLen}}/{{descMax}}</text>
      </view>
      <textarea class="textarea" placeholder="简单介绍这本书（选填）" placeholder-class="ph"
                maxlength="{{descMax}}" data-field="desc" value="{{desc}}" bindinput="onInput" />
    </view>
  </view>

  <view class="preview" wx:if="{{title}}">
    <view class="preview-label muted">效果预览</view>
    <view class="preview-card">
      <view class="preview-cover" style="background: linear-gradient(150deg, {{color}} 0%, {{color}}cc 100%)">
        <view class="preview-spine"></view>
        <text class="preview-title">{{title}}</text>
      </view>
      <view class="preview-info">
        <view class="preview-name">{{title}}</view>
        <view class="muted">{{author || '作者'}}</view>
      </view>
    </view>
  </view>

  <view class="btn-primary submit {{canSubmit ? '' : 'disabled'}}" bindtap="onSubmit">发布到书库</view>
</view>
